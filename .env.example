MISKOAI_LISTEN=127.0.0.1:8787
MISKOAI_DATA_DIR=./data
MISKOAI_DEEPSEEK_URL=https://api.deepseek.com
MISKOAI_MODEL=deepseek-flash
MISKOAI_VISION_MODEL=deepseek-flash
DEEPSEEK_API_KEY=example-not-a-real-key
OLLAMA_API_KEY=example-not-a-real-key
MISKOAI_ADMIN_PASSWORD=example-change-before-use
MISKOAI_WEIXIN_URL=https://ilinkai.weixin.qq.com
# WeChat credentials are created by interactive QR authorization; never pass tokens as CLI arguments.

MISKOAI_MAX_OUTPUT_TOKENS=512
MISKOAI_CONTEXT_BYTES=24576
MISKOAI_CONTEXT_TOKENS=32768
# Optional explicit private credential-file path; do not set an empty value.
# MISKOAI_CREDENTIALS_FILE=./secrets/api-keys.json
